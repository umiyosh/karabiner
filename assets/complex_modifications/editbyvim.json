{
  "title": "Edit by Vim",
  "rules": [
    {
      "description": "command+e to edit by vim",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "e",
            "modifiers": {
              "mandatory": ["left_command"]
            }
          },
          "to": [
            { "key_code": "a" , "modifiers": ["left_command"]},
            { "key_code": "c" , "modifiers": ["left_command"]},
            { "shell_command": "~/dotfiles/bin/mgv 1>/tmp/debug 2>&1" }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome"
              ]
            }
          ]
        }
      ]
    }
  ]
}
